# Backups made with the default BACKUP_DIR: whole VM disks, with every
# key and password stored on them. Never commit them. The folder itself
# stays in git (through .gitkeep) so the default location exists.
/backup/*
!/backup/.gitkeep

# The local configuration stays private; the example is the versioned
# one (ndm_virsh-kvm-backup-restore.conf.example).
/ndm_virsh-kvm-backup-restore.conf

# Interrupted backups, wherever BACKUP_DIR points inside this folder.
*.INVALID/

# Secrets never go in the repository, not even encrypted (CI secrets only)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.enc
*.gpg
*.age
*.kdbx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
.netrc
.pgpass
.htpasswd
credentials.json
# A public key kept on purpose (e.g. a debug key) needs its own "!path" line here
# and an entry in ALLOWED of scripts/check-secrets.sh
